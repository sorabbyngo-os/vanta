use std::{io::Cursor, time::Duration};

use smithay::{
    backend::{
        renderer::{
            damage::OutputDamageTracker,
            element::{
                memory::{MemoryRenderBuffer, MemoryRenderBufferRenderElement},
                render_elements,
                solid::SolidColorRenderElement,
                surface::WaylandSurfaceRenderElement,
                utils::{
                    ConstrainAlign, ConstrainScaleBehavior, CropRenderElement,
                    RelocateRenderElement, RescaleRenderElement,
                },
                AsRenderElements, Kind,
            },
            gles::GlesRenderer,
        },
        winit::{self, WinitEvent},
    },
    output::{Mode, Output, PhysicalProperties, Subpixel},
    reexports::calloop::EventLoop,
    utils::{IsAlive, Logical, Point, Rectangle, Scale, Transform},
};

use crate::{state::create_overview_glass_buffer, Vanta};

render_elements! {
    OverviewRenderElements<=GlesRenderer>;
    Solid=SolidColorRenderElement,
    Memory=MemoryRenderBufferRenderElement<GlesRenderer>,
    Space=smithay::desktop::space::SpaceRenderElements<
        GlesRenderer,
        WaylandSurfaceRenderElement<GlesRenderer>
    >,
    Thumbnail=CropRenderElement<
        RelocateRenderElement<
            RescaleRenderElement<WaylandSurfaceRenderElement<GlesRenderer>>
        >
    >,
}

fn load_wallpaper() -> Result<MemoryRenderBuffer, Box<dyn std::error::Error>> {
    let bytes = include_bytes!("../../../assets/wallpapers/vanta-default.png");
    let decoder = png::Decoder::new(Cursor::new(bytes.as_slice()));
    let mut reader = decoder.read_info()?;
    let mut decoded = vec![
        0;
        reader.output_buffer_size().ok_or_else(|| {
            std::io::Error::new(
                std::io::ErrorKind::InvalidData,
                "Invalid wallpaper dimensions",
            )
        })?
    ];
    let info = reader.next_frame(&mut decoded)?;
    let pixels = &decoded[..info.buffer_size()];

    let mut rgba = Vec::with_capacity(info.width as usize * info.height as usize * 4);
    match info.color_type {
        png::ColorType::Rgb => {
            for pixel in pixels.chunks_exact(3) {
                rgba.extend_from_slice(&[pixel[0], pixel[1], pixel[2], 255]);
            }
        }
        png::ColorType::Rgba => {
            for pixel in pixels.chunks_exact(4) {
                rgba.extend_from_slice(pixel);
            }
        }
        _ => {
            return Err(std::io::Error::new(
                std::io::ErrorKind::InvalidData,
                "Wallpaper must decode to RGB or RGBA",
            )
            .into());
        }
    }

    let width = i32::try_from(info.width)?;
    let height = i32::try_from(info.height)?;

    Ok(MemoryRenderBuffer::from_slice(
        &rgba,
        smithay::backend::allocator::Fourcc::Abgr8888,
        (width, height),
        1,
        Transform::Normal,
        None,
    ))
}

pub fn init_winit(
    event_loop: &mut EventLoop<Vanta>,
    state: &mut Vanta,
) -> Result<(), Box<dyn std::error::Error>> {
    let (mut backend, winit) = winit::init::<GlesRenderer>()?;
    backend.window().set_title("Vanta");
    backend.window().set_decorations(false);

    let mode = Mode {
        size: backend.window_size(),
        refresh: 60_000,
    };

    let output = Output::new(
        "vanta".to_string(),
        PhysicalProperties {
            size: (0, 0).into(),
            subpixel: Subpixel::Unknown,
            make: "Sorabbyngo".into(),
            model: "Vanta".into(),
            serial_number: "0".into(),
        },
    );

    let _global = output.create_global::<Vanta>(&state.display_handle);
    output.change_current_state(
        Some(mode),
        Some(Transform::Flipped180),
        None,
        Some((0, 0).into()),
    );
    output.set_preferred(mode);
    state.space.map_output(&output, (0, 0));
    state.output = Some(output.clone());
    state.relayout_windows();

    let mut damage_tracker = OutputDamageTracker::from_output(&output);
    let wallpaper_buffer = load_wallpaper()?;

    event_loop
        .handle()
        .insert_source(winit, move |event, _, state| {
            match event {
                WinitEvent::Resized { size, .. } => {
                    // Update the output geometry before recalculating
                    // layer-shell and window positions.
                    output.change_current_state(
                        Some(Mode {
                            size,
                            refresh: 60_000,
                        }),
                        None,
                        None,
                        None,
                    );

                    // Recalculate panel, dock, and other layer surfaces
                    // against the new output dimensions.
                    {
                        let mut layer_map =
                            smithay::desktop::layer_map_for_output(&output);
                        layer_map.arrange();
                    }

                    // Recalculate window layouts using the updated geometry.
                    state.relayout_windows();
                }
                WinitEvent::Input(event) => state.process_input_event(event),
                WinitEvent::Redraw => {
                    let size = backend.window_size();
                    let damage = Rectangle::from_size(size);
                    {
                        let (renderer, mut framebuffer) = backend.bind().unwrap();

                        let scale = output.current_scale().fractional_scale();
                        let mut custom_elements =
                            Vec::<OverviewRenderElements>::with_capacity(state.windows.len() + 16);
                        let mut wallpaper_element = None;

                        if let Some(geometry) = state.space.output_geometry(&output) {
                            if let Ok(element) = MemoryRenderBufferRenderElement::from_buffer(
                                renderer,
                                Point::<i32, Logical>::from((0, 0))
                                    .to_physical_precise_round(scale),
                                &wallpaper_buffer,
                                None,
                                None,
                                Some(geometry.size),
                                Kind::Unspecified,
                            ) {
                                wallpaper_element = Some(element.into());
                            }
                        }

                        if let Some(preview) = state.snap_preview {
                            state.snap_preview_buffer.resize(preview.size);
                            custom_elements.push(
                                SolidColorRenderElement::from_buffer(
                                    &state.snap_preview_buffer,
                                    preview.loc.to_physical_precise_round(scale),
                                    scale,
                                    1.0,
                                    Kind::Unspecified,
                                )
                                .into(),
                            );
                        }

                        if let Some(preview) = state.minimize_preview {
                            state.minimize_preview_buffer.resize(preview.size);
                            custom_elements.push(
                                SolidColorRenderElement::from_buffer(
                                    &state.minimize_preview_buffer,
                                    preview.loc.to_physical_precise_round(scale),
                                    scale,
                                    1.0,
                                    Kind::Unspecified,
                                )
                                .into(),
                            );
                        }

                        if state.overview_open {
                            if let Ok(element) = MemoryRenderBufferRenderElement::from_buffer(
                                renderer,
                                Point::<i32, Logical>::from((12, 12))
                                    .to_physical_precise_round(scale),
                                &state.overview_indicator_buffer,
                                None,
                                Some(Rectangle::from_size((128.0, 20.0).into())),
                                Some((128, 20).into()),
                                Kind::Unspecified,
                            ) {
                                custom_elements.push(element.into());
                            }

                            if let Some(layout) = state.overview_layout() {
                                while state.overview_card_buffers.len() < layout.thumbnails.len() {
                                    state.overview_card_buffers.push(create_overview_glass_buffer());
                                }

                                let overview_surfaces = layout
                                    .thumbnails
                                    .iter()
                                    .map(|(workspace, rect)| (*workspace, *rect, false))
                                    .chain(std::iter::once((
                                        state.active_workspace,
                                        layout.active_preview,
                                        true,
                                    )));

                                for (workspace, rect, is_main_preview) in overview_surfaces {
                                    let buffer = if is_main_preview {
                                        &mut state.overview_active_buffer
                                    } else {
                                        &mut state.overview_card_buffers[workspace as usize]
                                    };

                                    let inset = if is_main_preview { 16 } else { 5 };
                                    let reserved_height = if is_main_preview { 38 } else { 12 };
                                    let preview: Rectangle<i32, Logical> = Rectangle::new(
                                        (rect.loc.x + inset, rect.loc.y + inset).into(),
                                        (
                                            (rect.size.w - inset * 2).max(1),
                                            (rect.size.h - inset - reserved_height).max(1),
                                        )
                                            .into(),
                                    );

                                    // Build a miniature of the real workspace.
                                    // Every window uses the same scale and offset, preserving
                                    // desktop geometry, aspect ratio and relative placement.
                                    let mut windows: Vec<(
                                        u64,
                                        smithay::desktop::Window,
                                        Point<i32, Logical>,
                                        Rectangle<i32, Logical>,
                                    )> = state.windows.iter()
                                        .filter(|(id, window)| {
                                            state.window_workspaces.get(id) == Some(&workspace)
                                                && !state.minimized_windows.contains_key(id)
                                                && window.alive()
                                        })
                                        .filter_map(|(id, window)| {
                                            let location = state.space.element_location(window)
                                                .or_else(|| state.window_locations.get(id).copied())?;
                                            // Match the exact reference used by
                                            // constrain_space_element: the window bounding
                                            // box, including subsurfaces and popups.
                                            let geometry = window.geometry();
                                            let bbox = window.bbox_with_popups();

                                            // Space locations identify the geometry origin.
                                            // The render helper needs the bounding-box origin.
                                            let bounds = Rectangle::new(
                                                location + bbox.loc - geometry.loc,
                                                bbox.size,
                                            );

                                            Some((*id, window.clone(), location, bounds))
                                        })
                                        .collect();

                                    // Stable fallback ordering for unmapped workspaces.
                                    windows.sort_by_key(|(id, _, _, _)| *id);

                                    // Space::elements() is ordered back-to-front. Use that
                                    // order for the currently mapped workspace.
                                    let stacking: Vec<smithay::desktop::Window> =
                                        state.space.elements().cloned().collect();
                                    windows.sort_by_key(|(_, window, _, _)| {
                                        stacking.iter().position(|candidate| candidate == window)
                                            .unwrap_or(usize::MAX)
                                    });

                                    let discovered_windows = windows.len();
                                    let mut preview_render_elements = 0usize;

                                    if !windows.is_empty() {
                                        let min_x = windows.iter()
                                            .map(|(_, _, _, bounds)| bounds.loc.x)
                                            .min().unwrap();
                                        let min_y = windows.iter()
                                            .map(|(_, _, _, bounds)| bounds.loc.y)
                                            .min().unwrap();
                                        let max_x = windows.iter()
                                            .map(|(_, _, _, bounds)| bounds.loc.x + bounds.size.w)
                                            .max().unwrap();
                                        let max_y = windows.iter()
                                            .map(|(_, _, _, bounds)| bounds.loc.y + bounds.size.h)
                                            .max().unwrap();

                                        let workspace_width = (max_x - min_x).max(1);
                                        let workspace_height = (max_y - min_y).max(1);

                                        let uniform_scale = (
                                            preview.size.w as f64 / workspace_width as f64
                                        ).min(
                                            preview.size.h as f64 / workspace_height as f64
                                        );

                                        let rendered_width =
                                            (workspace_width as f64 * uniform_scale).round() as i32;
                                        let rendered_height =
                                            (workspace_height as f64 * uniform_scale).round() as i32;

                                        let offset_x =
                                            preview.loc.x + (preview.size.w - rendered_width) / 2;
                                        let offset_y =
                                            preview.loc.y + (preview.size.h - rendered_height) / 2;

                                        for (_, window, location, bounds) in windows {
                                            let target = Rectangle::new(
                                                (
                                                    offset_x + ((bounds.loc.x - min_x) as f64
                                                        * uniform_scale).round() as i32,
                                                    offset_y + ((bounds.loc.y - min_y) as f64
                                                        * uniform_scale).round() as i32,
                                                ).into(),
                                                (
                                                    ((bounds.size.w as f64 * uniform_scale)
                                                        .round() as i32).max(1),
                                                    ((bounds.size.h as f64 * uniform_scale)
                                                        .round() as i32).max(1),
                                                ).into(),
                                            );

                                            let preview_elements: Vec<_> =
                                                smithay::desktop::space::constrain_space_element::<
                                                    GlesRenderer,
                                                    smithay::desktop::Window,
                                                    OverviewRenderElements,
                                                    _,
                                                    _,
                                                >(
                                                    renderer,
                                                    &window,
                                                    location,
                                                    1.0,
                                                    scale,
                                                    target,
                                                    smithay::desktop::space::ConstrainBehavior {
                                                        reference: smithay::desktop::space::ConstrainReference::BoundingBox,
                                                        behavior: ConstrainScaleBehavior::Fit,
                                                        align: ConstrainAlign::CENTER,
                                                    },
                                                )
                                                .collect();

                                            preview_render_elements += preview_elements.len();
                                            custom_elements.extend(preview_elements);
                                        }
                                    }
                                    static OVERVIEW_DIAG_REPORTED: std::sync::atomic::AtomicBool =
                                        std::sync::atomic::AtomicBool::new(false);
                                    if !OVERVIEW_DIAG_REPORTED.swap(
                                        true,
                                        std::sync::atomic::Ordering::Relaxed,
                                    ) {
                                        eprintln!(
                                            "[VANTA-OVERVIEW-DIAG] workspace={} windows={} preview_render_elements={}",
                                            workspace,
                                            discovered_windows,
                                            preview_render_elements,
                                        );
                                    }

                                    if let Ok(element) = MemoryRenderBufferRenderElement::from_buffer(
                                        renderer,
                                        rect.loc.to_physical_precise_round(scale),
                                        buffer,
                                        None,
                                        Some(Rectangle::from_size((256.0, 160.0).into())),
                                        Some(rect.size),
                                        Kind::Unspecified,
                                    ) {
                                        custom_elements.push(element.into());
                                    }

                                }

                                let new_card = layout.new_workspace;
                                if let Ok(element) = MemoryRenderBufferRenderElement::from_buffer(
                                    renderer,
                                    new_card.loc.to_physical_precise_round(scale),
                                    &state.overview_new_buffer,
                                    None,
                                    None,
                                    Some(new_card.size),
                                    Kind::Unspecified,
                                ) {
                                    custom_elements.push(element.into());
                                }

                                let plus_width = 32_i32;
                                let plus_height = 4_i32;
                                let center_x = new_card.loc.x + new_card.size.w / 2;
                                let center_y = new_card.loc.y + new_card.size.h / 2;

                                state.overview_plus_buffer.resize((
                                    plus_height,
                                    plus_width,
                                ));
                                custom_elements.push(
                                    SolidColorRenderElement::from_buffer(
                                        &state.overview_plus_buffer,
                                        Point::<i32, Logical>::from((
                                            center_x - plus_height / 2,
                                            center_y - plus_width / 2,
                                        ))
                                        .to_physical_precise_round(scale),
                                        scale,
                                        1.0,
                                        Kind::Unspecified,
                                    )
                                    .into(),
                                );

                                state.overview_plus_vertical_buffer.resize((
                                    plus_width,
                                    plus_height,
                                ));
                                custom_elements.push(
                                    SolidColorRenderElement::from_buffer(
                                        &state.overview_plus_vertical_buffer,
                                        Point::<i32, Logical>::from((
                                            center_x - plus_width / 2,
                                            center_y - plus_height / 2,
                                        ))
                                        .to_physical_precise_round(scale),
                                        scale,
                                        1.0,
                                        Kind::Unspecified,
                                    )
                                    .into(),
                                );
                            }
                        }
                        let alpha = if state.overview_open { 0.55 } else { 1.0 };

                        // OutputDamageTracker expects front-to-back elements.
                        // It draws them in reverse: background first, foreground last.
                        let mut elements = Vec::with_capacity(custom_elements.len() + 32);

                        // Vanta overlays: overview cards, previews and other foreground UI.
                        elements.append(&mut custom_elements);

                        // Render layer-shell surfaces using their arranged LayerMap
                        // positions. Smithay's output helper currently drops those offsets.
                        let output_geometry =
                            state.space.output_geometry(&output).unwrap();

                        let (front_layers, back_layers) = {
                            let layer_map =
                                smithay::desktop::layer_map_for_output(&output);
                            let mut front = Vec::new();
                            let mut back = Vec::new();

                            for layer in layer_map.layers().rev() {
                                if let Some(geometry) = layer_map.layer_geometry(layer) {
                                    let entry = (layer.clone(), geometry);
                                    match layer.layer() {
                                        smithay::wayland::shell::wlr_layer::Layer::Overlay
                                        | smithay::wayland::shell::wlr_layer::Layer::Top => {
                                            front.push(entry);
                                        }
                                        smithay::wayland::shell::wlr_layer::Layer::Bottom
                                        | smithay::wayland::shell::wlr_layer::Layer::Background => {
                                            back.push(entry);
                                        }
                                    }
                                }
                            }

                            (front, back)
                        };

                        let mut space_elements =
                            Vec::<OverviewRenderElements>::with_capacity(32);

                        // Layer-shell surfaces are temporarily suppressed in Overview
                        // to isolate the source of the large L-shaped render regions.
                        if !state.overview_open {
                            for (layer, geometry) in front_layers {
                            let location = (geometry.loc - output_geometry.loc)
                                .to_physical_precise_round(scale);

                            let rendered = layer.render_elements::<
                                WaylandSurfaceRenderElement<GlesRenderer>,
                            >(
                                renderer,
                                location,
                                Scale::from(scale),
                                alpha,
                            );

                            space_elements.extend(rendered.into_iter().map(|element| {
                                OverviewRenderElements::Space(
                                    smithay::desktop::space::SpaceRenderElements::Surface(element),
                                )
                            }));
                            }
                        }

                        // Overview thumbnails replace full-size application windows.
                        if !state.overview_open {
                            let window_elements = state.space.render_elements_for_region(
                                renderer,
                                &output_geometry,
                                scale,
                                alpha,
                            );

                            space_elements.extend(window_elements.into_iter().map(|element| {
                                OverviewRenderElements::Space(
                                    smithay::desktop::space::SpaceRenderElements::Surface(element),
                                )
                            }));
                        }

                        // Bottom and background surfaces are also suppressed in Overview.
                        if !state.overview_open {
                            for (layer, geometry) in back_layers {
                            let location = (geometry.loc - output_geometry.loc)
                                .to_physical_precise_round(scale);

                            let rendered = layer.render_elements::<
                                WaylandSurfaceRenderElement<GlesRenderer>,
                            >(
                                renderer,
                                location,
                                Scale::from(scale),
                                alpha,
                            );

                            space_elements.extend(rendered.into_iter().map(|element| {
                                OverviewRenderElements::Space(
                                    smithay::desktop::space::SpaceRenderElements::Surface(element),
                                )
                            }));
                            }
                        }

                        // The corner hint belongs to the desktop background layer:
                        // above wallpaper, but below panels, windows and Overview UI.
                        if state.hot_corner_hint_visible {
                            if let Ok(element) = MemoryRenderBufferRenderElement::from_buffer(
                                renderer,
                                output_geometry.loc.to_physical_precise_round(scale),
                                &state.hot_corner_buffer,
                                None,
                                Some(Rectangle::from_size((24.0, 24.0).into())),
                                Some((24, 24).into()),
                                Kind::Unspecified,
                            ) {
                                space_elements.push(element.into());
                            }
                        }

                        elements.extend(space_elements);

                        // Wallpaper must be behind both the desktop and Vanta overlays.
                        if let Some(wallpaper) = wallpaper_element {
                            elements.push(wallpaper);
                        }

                        let clear_color = if state.overview_open {
                            [0.035, 0.052, 0.078, 1.0]
                        } else {
                            [0.05, 0.06, 0.09, 1.0]
                        };

                        damage_tracker
                            .render_output(
                                renderer,
                                &mut framebuffer,
                                0,
                                &elements,
                                clear_color,
                            )
                            .unwrap();
                    }
                    backend.submit(Some(&[damage])).unwrap();

                    if state.overview_open {
                        for (id, window) in &state.windows {
                            if !state.minimized_windows.contains_key(id) && window.alive() {
                                window.send_frame(
                                    &output,
                                    state.start_time.elapsed(),
                                    Some(Duration::ZERO),
                                    |_, _| Some(output.clone()),
                                );
                            }
                        }
                    } else {
                        state.space.elements().for_each(|window| {
                            window.send_frame(
                                &output,
                                state.start_time.elapsed(),
                                Some(Duration::ZERO),
                                |_, _| Some(output.clone()),
                            )
                        });
                    }

                    state.space.refresh();
                    state.popups.cleanup();
                    let _ = state.display_handle.flush_clients();
                    backend.window().request_redraw();
                }
                WinitEvent::CloseRequested => {
                    state.loop_signal.stop();
                }
                _ => (),
            };
        })?;

    Ok(())
}
