use png::{ColorType, Decoder, Transformations};
use std::{
    collections::HashMap,
    fs::File,
    path::{Path, PathBuf},
    sync::{Arc, Mutex, OnceLock},
};

const ICON_SIZE: u32 = 38;

#[derive(Clone)]
pub struct IconPixels {
    pub pixels: Arc<[u8]>,
    pub size: u32,
}

static CACHE: OnceLock<Mutex<HashMap<String, Option<Arc<IconPixels>>>>> =
    OnceLock::new();

fn cache() -> &'static Mutex<HashMap<String, Option<Arc<IconPixels>>>> {
    CACHE.get_or_init(|| Mutex::new(HashMap::new()))
}

pub fn get_icon(icon: Option<&str>) -> Option<Arc<IconPixels>> {
    let icon = icon?.trim();

    if icon.is_empty() {
        return None;
    }

    if let Ok(guard) = cache().lock() {
        if let Some(cached) = guard.get(icon) {
            return cached.clone();
        }
    }

    let loaded = resolve_icon(icon).and_then(decode_and_scale);

    if let Ok(mut guard) = cache().lock() {
        guard.insert(icon.to_owned(), loaded.clone());
    }

    loaded
}

fn resolve_icon(icon: &str) -> Option<PathBuf> {
    let direct = Path::new(icon);

    if direct.is_absolute() && direct.is_file() {
        return Some(direct.to_path_buf());
    }

    let name = direct
        .file_name()
        .and_then(|s| s.to_str())
        .unwrap_or(icon);

    let stem = name.strip_suffix(".png").unwrap_or(name);

    let mut roots = Vec::new();

    if let Ok(home) = std::env::var("HOME") {
        roots.push(PathBuf::from(home).join(".local/share/icons"));
        roots.push(PathBuf::from(home).join(".icons"));
        roots.push(PathBuf::from(home).join(".local/share/pixmaps"));
    }

    roots.push(PathBuf::from("/usr/share/icons"));
    roots.push(PathBuf::from("/usr/local/share/icons"));
    roots.push(PathBuf::from("/usr/share/pixmaps"));

    let themes = [
        "Adwaita",
        "hicolor",
        "breeze",
        "breeze-dark",
        "oxygen",
        "default",
    ];

    let sizes = [
        "256x256",
        "scalable",
        "128x128",
        "96x96",
        "64x64",
        "48x48",
        "32x32",
        "24x24",
        "22x22",
        "16x16",
    ];

    for root in roots {
        if root.ends_with("pixmaps") {
            for candidate in [
                root.join(format!("{stem}.png")),
                root.join(name),
            ] {
                if candidate.is_file() {
                    return Some(candidate);
                }
            }

            continue;
        }

        for theme in themes {
            for size in sizes {
                let candidate = root
                    .join(theme)
                    .join(size)
                    .join("apps")
                    .join(format!("{stem}.png"));

                if candidate.is_file() {
                    return Some(candidate);
                }
            }
        }

        for size in sizes {
            let candidate = root
                .join("hicolor")
                .join(size)
                .join("apps")
                .join(format!("{stem}.png"));

            if candidate.is_file() {
                return Some(candidate);
            }
        }
    }

    None
}

fn decode_and_scale(path: PathBuf) -> Option<Arc<IconPixels>> {
    let file = File::open(path).ok()?;
    let mut decoder = Decoder::new(file);

    decoder.set_transformations(
        Transformations::EXPAND | Transformations::STRIP_16,
    );

    let mut reader = decoder.read_info().ok()?;
    let buffer_size = reader.output_buffer_size()?;
    let mut buffer = vec![0; buffer_size];

    let info = reader.next_frame(&mut buffer).ok()?;

    if info.width == 0
        || info.height == 0
        || info.width > 2048
        || info.height > 2048
    {
        return None;
    }

    let source = &buffer[..info.buffer_size()];

    let channels = match info.color_type {
        ColorType::Rgb => 3,
        ColorType::Rgba => 4,
        ColorType::Grayscale => 1,
        ColorType::GrayscaleAlpha => 2,
        ColorType::Indexed => return None,
    };

    let expected =
        info.width as usize * info.height as usize * channels;

    if source.len() < expected {
        return None;
    }

    // Convert to premultiplied BGRA, matching Canvas' shm format.
    let mut bgra = Vec::with_capacity(
        info.width as usize * info.height as usize * 4,
    );

    for pixel in source.chunks_exact(channels) {
        let (r, g, b, a) = match info.color_type {
            ColorType::Rgb => (pixel[0], pixel[1], pixel[2], 255),
            ColorType::Rgba => (pixel[0], pixel[1], pixel[2], pixel[3]),
            ColorType::Grayscale => (pixel[0], pixel[0], pixel[0], 255),
            ColorType::GrayscaleAlpha => {
                (pixel[0], pixel[0], pixel[0], pixel[1])
            }
            ColorType::Indexed => unreachable!(),
        };

        let alpha = a as u16;

        bgra.extend_from_slice(&[
            ((b as u16 * alpha) / 255) as u8,
            ((g as u16 * alpha) / 255) as u8,
            ((r as u16 * alpha) / 255) as u8,
            a,
        ]);
    }

    // Scale into the app-grid's fixed icon dimensions.
    let mut scaled = vec![0u8; (ICON_SIZE * ICON_SIZE * 4) as usize];

    for y in 0..ICON_SIZE {
        for x in 0..ICON_SIZE {
            let sx = x * info.width / ICON_SIZE;
            let sy = y * info.height / ICON_SIZE;

            let src = ((sy * info.width + sx) * 4) as usize;
            let dst = ((y * ICON_SIZE + x) * 4) as usize;

            scaled[dst..dst + 4].copy_from_slice(&bgra[src..src + 4]);
        }
    }

    Some(Arc::new(IconPixels {
        pixels: scaled.into(),
        size: ICON_SIZE,
    }))
}
