use std::time::Duration;

use ab_glyph::{Font, FontRef, PxScale, ScaleFont};
use smithay_client_toolkit::{
    compositor::{CompositorHandler, CompositorState, FrameCallbackData},
    delegate_registry,
    output::{OutputHandler, OutputState},
    reexports::calloop::EventLoop,
    reexports::calloop_wayland_source::WaylandSource,
    registry::{ProvidesRegistryState, RegistryState},
    registry_handlers,
    seat::{
        pointer::{PointerEvent, PointerEventKind, PointerHandler},
        Capability, SeatHandler, SeatState,
    },
    shell::{
        xdg::{
            window::{Window, WindowConfigure, WindowDecorations, WindowHandler},
            XdgShell,
        },
        WaylandSurface,
    },
    shm::{slot::SlotPool, Shm, ShmHandler},
};
use wayland_client::{
    globals::registry_queue_init,
    protocol::{wl_output, wl_pointer, wl_seat, wl_shm, wl_surface},
    Connection, QueueHandle,
};

const INITIAL_WIDTH: u32 = 1100;
const INITIAL_HEIGHT: u32 = 760;
const WINDOW_DRAG_HEIGHT: u32 = 14;

const BG: [u8; 4] = [224, 232, 244, 255];
const SIDEBAR: [u8; 4] = [237, 243, 251, 190];
const CARD: [u8; 4] = [250, 253, 255, 178];
const ACTIVE: [u8; 4] = [184, 210, 242, 210];
const WHITE: [u8; 4] = [35, 48, 65, 255];
const MUTED: [u8; 4] = [102, 119, 139, 255];
const ACCENT: [u8; 4] = [83, 139, 224, 255];

struct Settings {
    registry_state: RegistryState,
    output_state: OutputState,
    seat_state: SeatState,
    pointer: Option<wl_pointer::WlPointer>,
    seat: Option<wl_seat::WlSeat>,
    selected_page: usize,
    appearance_theme: usize,
    accent_choice: usize,
    compositor: CompositorState,
    xdg_shell: XdgShell,
    shm: Shm,
    window: Window,
    pool: SlotPool,
    width: u32,
    height: u32,
    configured: bool,
    maximized: bool,
    exit: bool,
}

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let conn = Connection::connect_to_env()?;
    let (globals, event_queue) = registry_queue_init(&conn)?;
    let qh = event_queue.handle();

    let mut event_loop: EventLoop<Settings> = EventLoop::try_new()?;
    WaylandSource::new(conn.clone(), event_queue).insert(event_loop.handle())?;

    let compositor = CompositorState::bind(&globals, &qh)?;
    let output_state = OutputState::new(&globals, &qh);
    let xdg_shell = XdgShell::bind(&globals, &qh)?;
    let shm = Shm::bind(&globals, &qh)?;

    let surface = compositor.create_surface(&qh);
    let window = xdg_shell.create_window(surface, WindowDecorations::RequestServer, &qh);
    window.set_title("Settings");
    window.set_app_id("vanta-settings");
    window.set_min_size(Some((820, 560)));
    window.commit();

    let pool = SlotPool::new((INITIAL_WIDTH * INITIAL_HEIGHT * 4) as usize, &shm)?;

    let mut state = Settings {
        registry_state: RegistryState::new(&globals),
        output_state,
        seat_state: SeatState::new(&globals, &qh),
        pointer: None,
        seat: None,
        selected_page: 0,
        appearance_theme: 0,
        accent_choice: 0,
        compositor,
        xdg_shell,
        shm,
        window,
        pool,
        width: INITIAL_WIDTH,
        height: INITIAL_HEIGHT,
        configured: false,
        maximized: false,
        exit: false,
    };

    while !state.exit {
        event_loop.dispatch(Duration::from_millis(16), &mut state)?;
    }

    Ok(())
}

fn fill_rect(
    pixels: &mut [u8],
    width: u32,
    height: u32,
    x: u32,
    y: u32,
    w: u32,
    h: u32,
    color: [u8; 4],
) {
    let xmax = x.saturating_add(w).min(width);
    let ymax = y.saturating_add(h).min(height);

    for py in y.min(height)..ymax {
        for px in x.min(width)..xmax {
            let i = ((py * width + px) * 4) as usize;
            pixels[i..i + 4].copy_from_slice(&color);
        }
    }
}

fn rounded_rect(
    pixels: &mut [u8],
    width: u32,
    height: u32,
    x: u32,
    y: u32,
    w: u32,
    h: u32,
    radius: u32,
    color: [u8; 4],
) {
    if w == 0 || h == 0 { return; }
    let xmax = x.saturating_add(w).min(width);
    let ymax = y.saturating_add(h).min(height);
    let r = radius.min(w / 2).min(h / 2) as i32;

    for py in y.min(height)..ymax {
        for px in x.min(width)..xmax {
            let lx = (px - x) as i32;
            let ly = (py - y) as i32;
            let cx = if lx < r { r } else if lx >= w as i32-r { w as i32-r-1 } else { lx };
            let cy = if ly < r { r } else if ly >= h as i32-r { h as i32-r-1 } else { ly };
            let dx = lx-cx;
            let dy = ly-cy;
            if lx >= r || ly >= r || dx*dx+dy*dy <= r*r {
                let i = ((py*width+px)*4) as usize;
                let alpha = color[3] as u32;
                let inv = 255 - alpha;
                for c in 0..3 {
                    pixels[i+c] = ((pixels[i+c] as u32 * inv
                        + color[c] as u32 * alpha) / 255) as u8;
                }
                pixels[i+3] = 255;
            }
        }
    }
}

fn draw_text(
    pixels: &mut [u8],
    width: u32,
    height: u32,
    text: &str,
    x: f32,
    baseline: f32,
    size: f32,
    color: [u8; 4],
) {
    let font_data = include_bytes!("/usr/share/fonts/adwaita-sans-fonts/AdwaitaSans-Regular.ttf");
    let Ok(font) = FontRef::try_from_slice(font_data) else {
        return;
    };

    let scaled = font.as_scaled(PxScale::from(size));
    let mut cursor_x = x;

    for ch in text.chars() {
        let glyph_id = scaled.glyph_id(ch);
        let glyph = glyph_id
            .with_scale_and_position(PxScale::from(size), ab_glyph::point(cursor_x, baseline));

        if glyph_id.0 != 0 {
            if let Some(outline) = font.outline_glyph(glyph) {
                let bounds = outline.px_bounds();
                outline.draw(|gx, gy, coverage| {
                    let px = bounds.min.x as i32 + gx as i32;
                    let py = bounds.min.y as i32 + gy as i32;

                    if px < 0 || py < 0 || px >= width as i32 || py >= height as i32 {
                        return;
                    }

                    let i = ((py as u32 * width + px as u32) * 4) as usize;
                    let alpha = (coverage * color[3] as f32).clamp(0.0, 255.0) as u8;

                    // Blend the glyph into the BGRA buffer.
                    let a = alpha as f32 / 255.0;
                    for channel in 0..3 {
                        pixels[i + channel] = (pixels[i + channel] as f32 * (1.0 - a)
                            + color[channel] as f32 * a)
                            as u8;
                    }
                });
            }
        }

        cursor_x += scaled.h_advance(glyph_id);
    }
}

const SETTINGS_CONTENT_X: u32 = 310;
const SETTINGS_CONTENT_RIGHT_MARGIN: u32 = 40;
const SETTINGS_CONTENT_TOP: u32 = 135;
const SETTINGS_CARD_GAP: u32 = 20;

fn overview_card_rect(width: u32, height: u32, index: u32) -> (u32, u32, u32, u32) {
    let content_width = width
        .saturating_sub(SETTINGS_CONTENT_X + SETTINGS_CONTENT_RIGHT_MARGIN)
        .max(1);

    let available_height = height.saturating_sub(SETTINGS_CONTENT_TOP + 40 + SETTINGS_CARD_GAP * 2);
    let card_height = (available_height / 3).max(120);
    let y = SETTINGS_CONTENT_TOP + index * (card_height + SETTINGS_CARD_GAP);

    (SETTINGS_CONTENT_X, y, content_width, card_height)
}

fn settings_page_card_rect(width: u32, height: u32) -> (u32, u32, u32, u32) {
    let content_width = width
        .saturating_sub(SETTINGS_CONTENT_X + SETTINGS_CONTENT_RIGHT_MARGIN)
        .max(1);
    let card_height = height.saturating_sub(175).max(170);

    (
        SETTINGS_CONTENT_X,
        SETTINGS_CONTENT_TOP,
        content_width,
        card_height,
    )
}

impl Settings {
    fn draw(&mut self, _conn: &Connection, qh: &QueueHandle<Self>) {
        let width = self.width;
        let height = self.height;
        let stride = (width * 4) as i32;

        let (bg, sidebar, card, active, white, muted) = if self.appearance_theme == 0 {
            (BG, SIDEBAR, CARD, ACTIVE, WHITE, MUTED)
        } else {
            ([35, 43, 58, 255], [48, 58, 76, 215], [66, 79, 100, 205], [90, 122, 166, 225], [239, 246, 255, 255], [170, 188, 209, 255])
        };

        let accent_colors = [
            [154, 190, 255, 255],
            [190, 150, 255, 255],
            [130, 220, 170, 255],
            [255, 145, 175, 255],
        ];
        let accent = accent_colors[self.accent_choice % accent_colors.len()];

        let Ok((buffer, canvas)) = self.pool.create_buffer(
            width as i32,
            height as i32,
            stride,
            wl_shm::Format::Argb8888,
        ) else {
            return;
        };

        let mut canvas = canvas;
        for pixel in canvas.chunks_exact_mut(4) {
            pixel.copy_from_slice(&bg);
        }

        rounded_rect(&mut canvas, width, height, 0, 0, 270, height, 24, sidebar);
        fill_rect(
            &mut canvas,
            width,
            height,
            269,
            0,
            1,
            height,
            [55, 49, 44, 255],
        );

        // Native window controls, anchored to the right edge.
        let controls_y = 16;
        let controls = [
            (width.saturating_sub(144), [65, 72, 88, 210], "-"),
            (width.saturating_sub(96), [65, 72, 88, 210], "□"),
            (width.saturating_sub(48), [130, 62, 62, 220], "×"),
        ];

        for (x, color, glyph) in controls {
            rounded_rect(&mut canvas, width, height, x, controls_y, 34, 30, 9, color);
            draw_text(
                &mut canvas,
                width,
                height,
                glyph,
                x as f32 + 11.0,
                37.0,
                17.0,
                white,
            );
        }

        // Brand and sidebar navigation.
        draw_text(&mut canvas, width, height, "VANTA", 28.0, 52.0, 23.0, white);
        draw_text(
            &mut canvas,
            width,
            height,
            "SYSTEM SETTINGS",
            28.0,
            78.0,
            11.0,
            muted,
        );

        let pages = [
            "Overview",
            "Appearance",
            "Display",
            "Windows & Desktop",
            "Network",
            "Bluetooth",
            "Power",
            "Devices",
        ];

        for (index, page) in pages.iter().enumerate() {
            let y = 105 + index as u32 * 47;

            if index == self.selected_page {
                rounded_rect(&mut canvas, width, height, 18, y, 230, 42, 14, active);
            }

            draw_text(
                &mut canvas,
                width,
                height,
                page,
                48.0,
                y as f32 + 27.0,
                16.0,
                if index == self.selected_page {
                    white
                } else {
                    muted
                },
            );
        }

        // Responsive page content.
        let content_x = SETTINGS_CONTENT_X;

        let pages = [
            "Overview",
            "Appearance",
            "Display",
            "Windows & Desktop",
            "Network",
            "Bluetooth",
            "Power",
            "Devices",
        ];

        draw_text(
            &mut canvas,
            width,
            height,
            pages[self.selected_page],
            content_x as f32,
            76.0,
            30.0,
            white,
        );

        if self.selected_page == 0 {
            draw_text(
                &mut canvas,
                width,
                height,
                "Configure and explore your desktop.",
                content_x as f32,
                105.0,
                16.0,
                muted,
            );

            let cards = [
                (
                    "Appearance",
                    "Personalize the look, colors and desktop surfaces.",
                    "Open Appearance  >",
                ),
                (
                    "Windows & Desktop",
                    "Layouts, window behavior and workspace settings.",
                    "Open Window Settings  >",
                ),
                (
                    "Network",
                    "Connectivity and system services.",
                    "Explore Network  >",
                ),
            ];

            for (index, (title, description, action)) in cards.into_iter().enumerate() {
                let (card_x, card_y, card_width, card_height) =
                    overview_card_rect(width, height, index as u32);

                rounded_rect(&mut canvas, width, height, card_x, card_y, card_width, card_height, 20, card);

                let text_x = card_x as f32 + 30.0;
                let title_y = card_y + card_height / 2 - 22;

                draw_text(
                    &mut canvas,
                    width,
                    height,
                    title,
                    text_x,
                    title_y as f32,
                    21.0,
                    white,
                );

                draw_text(
                    &mut canvas,
                    width,
                    height,
                    description,
                    text_x,
                    (title_y + 33) as f32,
                    15.0,
                    muted,
                );

                draw_text(
                    &mut canvas,
                    width,
                    height,
                    action,
                    text_x,
                    (title_y + 70) as f32,
                    15.0,
                    accent,
                );
            }
        } else {
            let descriptions = [
                "Configure and explore your desktop.",
                "Theme, accent colors, transparency and desktop surfaces.",
                "Display modes, resolution and scaling.",
                "Window layouts, workspaces, animation and desktop behavior.",
                "Network connections and connectivity settings.",
                "Bluetooth status and paired-device management.",
                "Power profile, battery information and power behavior.",
                "Input devices and supported hardware controls.",
            ];

            let (card_x, card_y, card_width, card_height) = settings_page_card_rect(width, height);

            rounded_rect(&mut canvas, width, height, card_x, card_y, card_width, card_height, 20, card);

            draw_text(
                &mut canvas,
                width,
                height,
                descriptions[self.selected_page],
                card_x as f32 + 30.0,
                (card_y + 50) as f32,
                16.0,
                muted,
            );

            if self.selected_page == 1 {
                draw_text(&mut canvas, width, height, "Theme", card_x as f32 + 30.0, (card_y + 105) as f32, 18.0, white);

                let themes = ["Dark", "Light", "System"];
                for (index, theme) in themes.iter().enumerate() {
                    let x = card_x + 30 + index as u32 * 145;
                    let y = card_y + 125;
                    let selected = self.appearance_theme == index;
                    rounded_rect(&mut canvas, width, height, x, y, 125, 44, 12, if selected { active } else { sidebar });
                    draw_text(&mut canvas, width, height, theme, x as f32 + 18.0, y as f32 + 28.0, 15.0, white);
                    if selected {
                        rounded_rect(&mut canvas, width, height, x + 10, y + 40, 105, 3, 2, accent);
                    }
                }

                draw_text(&mut canvas, width, height, "Accent color", card_x as f32 + 30.0, (card_y + 215) as f32, 18.0, white);
                let names = ["Blue", "Purple", "Green", "Rose"];
                for (index, name) in names.iter().enumerate() {
                    let x = card_x + 30 + index as u32 * 145;
                    let y = card_y + 235;
                    rounded_rect(&mut canvas, width, height, x, y, 125, 48, 12, sidebar);
                    rounded_rect(&mut canvas, width, height, x + 12, y + 12, 24, 24, 8, accent_colors[index]);
                    draw_text(&mut canvas, width, height, name, x as f32 + 46.0, y as f32 + 30.0, 15.0, white);
                    if self.accent_choice == index {
                        rounded_rect(&mut canvas, width, height, x + 10, y + 44, 105, 3, 2, accent_colors[index]);
                    }
                }

                draw_text(&mut canvas, width, height, "Changes preview immediately in this window.", card_x as f32 + 30.0, (card_y + 330) as f32, 14.0, muted);
            } else {
                draw_text(
                    &mut canvas,
                    width,
                    height,
                    "Settings controls will be added to this page.",
                    card_x as f32 + 30.0,
                    (card_y + 95) as f32,
                    15.0,
                    muted,
                );
            }
        }

        buffer.attach_to(self.window.wl_surface()).ok();
        self.window
            .wl_surface()
            .damage_buffer(0, 0, width as i32, height as i32);
        self.window
            .wl_surface()
            .frame(qh, FrameCallbackData(self.window.wl_surface().clone()));
        self.window.commit();
    }
}

impl CompositorHandler for Settings {
    fn scale_factor_changed(
        &mut self,
        _conn: &Connection,
        _qh: &QueueHandle<Self>,
        _surface: &wl_surface::WlSurface,
        _new_factor: i32,
    ) {
    }

    fn transform_changed(
        &mut self,
        _conn: &Connection,
        _qh: &QueueHandle<Self>,
        _surface: &wl_surface::WlSurface,
        _new_transform: wl_output::Transform,
    ) {
    }

    fn frame(
        &mut self,
        conn: &Connection,
        qh: &QueueHandle<Self>,
        _surface: &wl_surface::WlSurface,
        _time: u32,
    ) {
        if self.configured {
            self.draw(conn, qh);
        }
    }

    fn surface_enter(
        &mut self,
        _conn: &Connection,
        _qh: &QueueHandle<Self>,
        _surface: &wl_surface::WlSurface,
        _output: &wl_output::WlOutput,
    ) {
    }

    fn surface_leave(
        &mut self,
        _conn: &Connection,
        _qh: &QueueHandle<Self>,
        _surface: &wl_surface::WlSurface,
        _output: &wl_output::WlOutput,
    ) {
    }
}

impl WindowHandler for Settings {
    fn request_close(&mut self, _conn: &Connection, _qh: &QueueHandle<Self>, _window: &Window) {
        self.exit = true;
    }

    fn configure(
        &mut self,
        conn: &Connection,
        qh: &QueueHandle<Self>,
        _window: &Window,
        configure: WindowConfigure,
        _serial: u32,
    ) {
        self.maximized = configure.is_maximized();

        if let Some(w) = configure.new_size.0 {
            self.width = w.get();
        }

        if let Some(h) = configure.new_size.1 {
            self.height = h.get();
        }

        self.configured = true;
        self.draw(conn, qh);
    }
}

impl OutputHandler for Settings {
    fn output_state(&mut self) -> &mut OutputState {
        &mut self.output_state
    }

    fn new_output(
        &mut self,
        _conn: &Connection,
        _qh: &QueueHandle<Self>,
        _output: wl_output::WlOutput,
    ) {
    }
    fn update_output(
        &mut self,
        _conn: &Connection,
        _qh: &QueueHandle<Self>,
        _output: wl_output::WlOutput,
    ) {
    }
    fn output_destroyed(
        &mut self,
        _conn: &Connection,
        _qh: &QueueHandle<Self>,
        _output: wl_output::WlOutput,
    ) {
    }
}

impl SeatHandler for Settings {
    fn seat_state(&mut self) -> &mut SeatState {
        &mut self.seat_state
    }

    fn new_seat(&mut self, _conn: &Connection, _qh: &QueueHandle<Self>, _seat: wl_seat::WlSeat) {}

    fn new_capability(
        &mut self,
        _conn: &Connection,
        qh: &QueueHandle<Self>,
        seat: wl_seat::WlSeat,
        capability: Capability,
    ) {
        if capability == Capability::Pointer && self.pointer.is_none() {
            self.seat = Some(seat.clone());
            if let Ok(pointer) = self.seat_state.get_pointer(qh, &seat) {
                self.pointer = Some(pointer);
            }
        }
    }

    fn remove_capability(
        &mut self,
        _conn: &Connection,
        _qh: &QueueHandle<Self>,
        _seat: wl_seat::WlSeat,
        capability: Capability,
    ) {
        if capability == Capability::Pointer {
            if let Some(pointer) = self.pointer.take() {
                pointer.release();
            }
            self.seat = None;
        }
    }

    fn remove_seat(&mut self, _conn: &Connection, _qh: &QueueHandle<Self>, _seat: wl_seat::WlSeat) {
    }
}

impl PointerHandler for Settings {
    fn pointer_frame(
        &mut self,
        conn: &Connection,
        qh: &QueueHandle<Self>,
        _pointer: &wl_pointer::WlPointer,
        events: &[PointerEvent],
    ) {
        for event in events {
            if event.surface != *self.window.wl_surface() {
                continue;
            }

            if let PointerEventKind::Press { button, serial, .. } = event.kind {
                if button != 0x110 {
                    continue;
                }

                let (x, y) = event.position;
                let x = x as u32;
                let y = y as u32;

                // Invisible top drag strip: delegate movement to the compositor.
                if y < WINDOW_DRAG_HEIGHT {
                    if let Some(seat) = self.seat.as_ref() {
                        self.window.move_(seat, serial);
                    }
                    continue;
                }

                // Window controls.
                if (16..46).contains(&y) {
                    if x >= self.width.saturating_sub(144) && x < self.width.saturating_sub(110) {
                        self.window.set_minimized();
                        continue;
                    } else if x >= self.width.saturating_sub(96)
                        && x < self.width.saturating_sub(62)
                    {
                        if self.maximized {
                            self.window.unset_maximized();
                        } else {
                            self.window.set_maximized();
                        }
                        continue;
                    } else if x >= self.width.saturating_sub(48)
                        && x < self.width.saturating_sub(14)
                    {
                        self.exit = true;
                        continue;
                    }
                }

                let mut page = None;

                // Sidebar navigation.
                if (18..248).contains(&x) && (105..481).contains(&y) {
                    page = Some(((y - 105) / 47) as usize);
                }

                // Overview shortcuts follow the same responsive card geometry.
                if self.selected_page == 0 {
                    for index in 0..3 {
                        let (card_x, card_y, card_width, card_height) =
                            overview_card_rect(self.width, self.height, index);

                        let inside_x = x >= card_x && x < card_x.saturating_add(card_width);
                        let inside_y = y >= card_y && y < card_y.saturating_add(card_height);

                        if inside_x && inside_y {
                            page = Some(match index {
                                0 => 1,
                                1 => 3,
                                2 => 4,
                                _ => unreachable!(),
                            });
                            break;
                        }
                    }
                }

                // Appearance selections are handled independently from navigation.
                if self.selected_page == 1 {
                    let (card_x, card_y, _, _) = settings_page_card_rect(self.width, self.height);
                    let mut changed = false;

                    if y >= card_y + 125 && y < card_y + 169 {
                        for index in 0..3 {
                            let x0 = card_x + 30 + index as u32 * 145;
                            if x >= x0 && x < x0 + 125 {
                                if self.appearance_theme != index {
                                    self.appearance_theme = index;
                                    changed = true;
                                }
                            }
                        }
                    }

                    if y >= card_y + 235 && y < card_y + 283 {
                        for index in 0..4 {
                            let x0 = card_x + 30 + index as u32 * 145;
                            if x >= x0 && x < x0 + 125 {
                                if self.accent_choice != index {
                                    self.accent_choice = index;
                                    changed = true;
                                }
                            }
                        }
                    }

                    if changed {
                        self.draw(conn, qh);
                        continue;
                    }
                }

                if let Some(page) = page {
                    if page < 8 && page != self.selected_page {
                        self.selected_page = page;
                        if self.configured {
                            self.draw(conn, qh);
                        }
                    }
                }
            }
        }
    }
}

impl ShmHandler for Settings {
    fn shm_state(&mut self) -> &mut Shm {
        &mut self.shm
    }
}

delegate_registry!(Settings);

impl ProvidesRegistryState for Settings {
    fn registry(&mut self) -> &mut RegistryState {
        &mut self.registry_state
    }

    registry_handlers![OutputState, SeatState,];
}

smithay_client_toolkit::delegate_dispatch2!(Settings);
